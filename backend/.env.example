# SCuilONE Backend Environment Configuration
PROJECT_NAME="SCuilONE - Multi-Industry Multi-Tenant CRM"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10

# Database
# For SQLite local development:
DATABASE_URL="sqlite:///./scuilone.db"
# For PostgreSQL container / production:
# DATABASE_URL="postgresql://scuilone_user:scuilone_pass@localhost:5432/scuilone_db"

# Real Email / SMTP Settings (Optional in local development - OTPs will log to console)
ENABLE_REAL_EMAIL=false
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-sendgrid-api-key"
SMTP_FROM_EMAIL="noreply@scuilone.com"
SMTP_FROM_NAME="SCuilONE CRM"
